const int LED2 = 5;
const int LED3 = 3;
const int SW2 = 2;
const int SW3 = 4;

int BUTTON_COUNT = 0;

void setup() {
  PinMode(LED2,OUTPUT);
  PinMode(LED3,OUTPUT);

  PinMode(SW2,INPUT);
  PinMode(SW3,INPUT);

 DigitalWrite(LED3,HIGH);

 Serial.begin(9600);

}

void loop() {
    int S2_State = DigitalRead(SW2);
    int S3_State = DigitalRead(SW3);

    if (S2_State == HIGH && S3_State == HIGH) {

      BUTTON_COUNT = 0;
      DigitalWrite(LED2,HIGH);
}
else{

   DigitalWrite(LED2,LOW);

  If (S2_State == HIGH)
    BUTTON_COUNT++;

  If (S3_State == HIGH)
     BUTTON_COUNT--;

}

Serial.print("Button Count = ");
   








